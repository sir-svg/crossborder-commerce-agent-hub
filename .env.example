# 演示模式不需要密钥。复制为 .env 后按需修改。
DATABASE_PATH=data/commerce.db
MEMORY_BACKEND=sqlite
# 可选 redis: MEMORY_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
KNOWLEDGE_BACKEND=local
# 可选 milvus: 安装 uv sync --extra milvus，再设置 KNOWLEDGE_BACKEND=milvus
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
# 留空时通过内置 ASGI 服务进行真实 A2A JSON-RPC 协议调用。
# 独立服务示例：http://localhost:8001 和 http://localhost:8002
SUPPLIER_URL=
LOGISTICS_URL=
# 留空时使用进程内 FastMCP Client；独立工具服务：http://localhost:8003/mcp
MCP_URL=
# 可选：配置密钥后启用模型规划、四类助手分析和流式结果撰写。
# BASE_URL 应包含 /v1，服务商密钥只放本机 .env。
LLM_BASE_URL=https://ws-wx3zg6zl1sf52rk4.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash-1017
LLM_TIMEOUT_SECONDS=40
WORKFLOW_TIMEOUT_SECONDS=240
# 可选本机密码保护；线上 PUBLIC_DEMO=true 时必须设置至少12位的访问密码。
PUBLIC_DEMO=false
DEMO_USERNAME=demo
DEMO_PASSWORD=
# Render 免费版使用临时文件，休眠、重启或重新部署后会重置。
DEMO_TEMPORARY_DATA=false
